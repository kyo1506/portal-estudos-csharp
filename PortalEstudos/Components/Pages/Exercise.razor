@page "/week/{weekId}/exercise/{exerciseId}"
@using PortalEstudos.Models
@using PortalEstudos.Services
@using MudBlazor
@inject IContentService ContentService
@inject IProgressService ProgressService
@inject NavigationManager NavigationManager

<PageTitle>@exercise?.Title - Portal de Estudos C#</PageTitle>

@if (exercise == null || week == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="3">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" Class="mb-2">Exercício não encontrado</MudText>
        <MudText Class="mud-text-secondary mb-4">O exercício que você procura não existe.</MudText>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="NavigateToWeek">Voltar para Semana</MudButton>
    </MudPaper>
}
else
{
    <MudBreadcrumbs Class="mb-3">
        <MudLink Href="/weeks">Semanas</MudLink>
        <MudLink Href="@($"/week/{week.Id}")">Semana @week.Id</MudLink>
        <MudText>Exercício</MudText>
    </MudBreadcrumbs>

    <MudGrid Spacing="4">
        <MudItem xs="12" lg="8">
            <!-- Descrição -->
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold">💻 @exercise.Title</MudText>
                <div style="display:flex; gap:0.5rem; margin:0.5rem 0;">
                    <MudChip T="string" Color="@GetDifficultyColor(exercise.Difficulty)" Variant="Variant.Filled" Size="Size.Small">
                        @GetDifficultyText(exercise.Difficulty)
                    </MudChip>
                    @if (userProgress.CompletedExercises.Contains(exercise.Id))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Concluído
                        </MudChip>
                    }
                </div>
                <MudDivider Class="mb-3" />
                <MudText Class="mb-0" Style="line-height:1.7;">@exercise.Description</MudText>
            </MudPaper>

            <!-- Editor (MudTextField nativo, sem CDN) -->
            <MudPaper Class="mb-4" Elevation="2">
                <MudToolBar Style="background:#1e1e2e; color:white;">
                    <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />
                    <MudText>Editor C#</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" Color="Color.Default" OnClick="ResetCode" Title="Resetar código" />
                </MudToolBar>
                <div style="padding:0.75rem; background:#1e1e2e;">
                    <MudTextField @bind-Value="@userCode" Lines="18" FullWidth Variant="Variant.Outlined"
                                  Style="font-family:'Cascadia Code','Fira Code',monospace; font-size:0.9rem; background:#1e1e2e; color:#d4d4d4;"
                                  Immediate="true" />
                </div>
            </MudPaper>

            <!-- Ações -->
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="8">
                    <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" FullWidth OnClick="SubmitExercise" Disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate Class="mr-2" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-1" />
                        }
                        @submitStatus
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="4">
                    @if (exercise.Hints.Any())
                    {
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Large" FullWidth OnClick="ToggleHints">
                            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-1" /> Dicas (@currentHintIndex/@exercise.Hints.Count)
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            <!-- Dicas -->
            @if (showHints && visibleHints.Any())
            {
                <MudPaper Class="pa-3 mb-4" Elevation="2" Style="border-left:4px solid #ffc107;">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-1" /> Dicas
                    </MudText>
                    <MudList T="string" Dense>
                        @foreach (var hint in visibleHints)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.TipsAndUpdates" IconColor="Color.Warning">
                                @hint
                            </MudListItem>
                        }
                    </MudList>
                    @if (currentHintIndex < exercise.Hints.Count)
                    {
                        <MudButton Color="Color.Warning" Variant="Variant.Text" OnClick="ShowNextHint">Mostrar próxima dica</MudButton>
                    }
                </MudPaper>
            }

            <!-- Resultado -->
            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <MudPaper Class="mb-4" Elevation="2" Style="@($"border-left:4px solid {(isCorrect ? "#28a745" : "#dc3545")};")">
                    <MudAlert Severity="@(isCorrect ? Severity.Success : Severity.Error)" NoIcon="false">
                        <MudText Class="font-weight-bold">@(isCorrect ? "Correto!" : "Resultado")</MudText>
                        <div>@resultMessage</div>
                        @if (!isCorrect && !string.IsNullOrEmpty(userCodeOutput))
                        {
                            <div class="code-block mt-2">@userCodeOutput</div>
                        }
                    </MudAlert>
                </MudPaper>
            }
        </MudItem>

        <!-- Sidebar -->
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-3 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Class="mr-1" /> Saída Esperada
                </MudText>
                <div class="code-block">@exercise.ExpectedOutput</div>
            </MudPaper>

            <MudPaper Class="pa-3 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" />Exercícios da Semana
                </MudText>
                <MudList T="ExerciseModel" Dense>
                    @foreach (var e in week.Exercises)
                    {
                        <MudListItem T="ExerciseModel" Href="@($"/week/{week.Id}/exercise/{e.Id}")"
                                     Icon="@(e.Id == exercise.Id ? Icons.Material.Filled.Code : Icons.Material.Filled.CodeOff)"
                                     IconColor="@(e.Id == exercise.Id ? Color.Primary : Color.Default)">
                            <div style="display:flex; align-items:center; width:100%;">
                                <MudText Class="@(e.Id == exercise.Id ? "font-weight-bold" : "")">@e.Title</MudText>
                                @if (userProgress.CompletedExercises.Contains(e.Id))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="ml-auto" />
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            @if (!string.IsNullOrEmpty(exercise.Solution))
            {
                <MudPaper Class="pa-3 mb-4" Elevation="2">
                    @if (showSolution)
                    {
                        <MudButton Color="Color.Default" Variant="Variant.Text" FullWidth OnClick="ToggleSolution" StartIcon="@Icons.Material.Filled.VisibilityOff">
                            Ocultar Solução
                        </MudButton>
                        <div class="code-block mt-2">@exercise.Solution</div>
                    }
                    else
                    {
                        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" FullWidth OnClick="ToggleSolution" StartIcon="@Icons.Material.Filled.Key">
                            Mostrar Solução
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private WeekModel? week;
    private Models.ExerciseModel? exercise;
    private UserProgress userProgress = new();
    private string userCode = "";
    private bool isSubmitting = false;
    private bool isCorrect = false;
    private string resultMessage = "";
    private string userCodeOutput = "";
    private string submitStatus = "Executar e Verificar";
    private bool showHints = false;
    private int currentHintIndex = 0;
    private List<string> visibleHints = new();
    private bool showSolution = false;

    [Parameter]
    public string? WeekId { get; set; }

    [Parameter]
    public string? ExerciseId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(WeekId, out int weekId) && int.TryParse(ExerciseId, out int exerciseId))
        {
            week = ContentService.GetWeek(weekId);
            exercise = ContentService.GetExercise(weekId, exerciseId);
            if (exercise != null)
            {
                userCode = exercise.InitialCode;
            }
        }
        userProgress = await ProgressService.LoadAsync();
    }

    private Color GetDifficultyColor(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => Color.Success,
        ExerciseDifficulty.Medium => Color.Warning,
        ExerciseDifficulty.Hard => Color.Error,
        _ => Color.Default
    };

    private string GetDifficultyText(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => "Fácil",
        ExerciseDifficulty.Medium => "Médio",
        ExerciseDifficulty.Hard => "Difícil",
        _ => "Desconhecido"
    };

    private void ResetCode()
    {
        if (exercise != null)
        {
            userCode = exercise.InitialCode;
            resultMessage = "";
            userCodeOutput = "";
        }
    }

    private void ToggleHints()
    {
        showHints = !showHints;
        if (showHints)
        {
            visibleHints.Clear();
            currentHintIndex = 0;
        }
    }

    private void ShowNextHint()
    {
        if (exercise != null && currentHintIndex < exercise.Hints.Count)
        {
            visibleHints.Add(exercise.Hints[currentHintIndex]);
            currentHintIndex++;
        }
    }

    private void ToggleSolution()
    {
        showSolution = !showSolution;
    }

    private async Task SubmitExercise()
    {
        if (exercise == null) return;

        isSubmitting = true;
        submitStatus = "Verificando...";
        StateHasChanged();

        await Task.Delay(500);

        var codeContainsExpected = CheckCodeForExpectedOutput(userCode, exercise);

        if (codeContainsExpected)
        {
            isCorrect = true;
            resultMessage = "Excelente! Seu código produz a saída esperada.";
            userCodeOutput = exercise.ExpectedOutput;
            await ProgressService.MarkExerciseCompleteAsync(exercise.Id, userCode);
            userProgress = await ProgressService.LoadAsync();
        }
        else
        {
            isCorrect = false;
            resultMessage = "Ainda não está correto. Verifique a saída esperada e tente novamente.";
            userCodeOutput = SimulateCodeOutput(userCode, exercise);
        }

        isSubmitting = false;
        submitStatus = "Executar e Verificar";
        StateHasChanged();
    }

    private bool CheckCodeForExpectedOutput(string code, Models.ExerciseModel exercise)
    {
        if (string.IsNullOrWhiteSpace(code)) return false;
        if (code.Trim() == exercise.InitialCode.Trim()) return false;

        var hasConsoleOutput = code.Contains("Console.WriteLine") || code.Contains("Console.Write");
        var hasLogic = code.Contains("new ") || code.Contains("var ") || code.Contains("foreach") ||
                       code.Contains("for") || code.Contains("if") || code.Contains("=>") ||
                       code.Contains("Where") || code.Contains("Select") || code.Contains("GroupBy") ||
                       code.Contains("OrderBy") || code.Contains("Sum") || code.Contains("Results.");

        return hasConsoleOutput && hasLogic;
    }

    private string SimulateCodeOutput(string code, Models.ExerciseModel exercise)
    {
        if (code.Contains("Console.WriteLine"))
        {
            return "[Saída simulada - execute em seu ambiente para ver o resultado]";
        }
        return "[Código não produz saída visível]";
    }

    private void NavigateToWeek()
    {
        NavigationManager.NavigateTo($"/week/{WeekId}");
    }
}
