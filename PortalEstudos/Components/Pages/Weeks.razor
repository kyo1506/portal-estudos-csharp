@page "/weeks"
@using PortalEstudos.Models
@using PortalEstudos.Services
@inject IContentService ContentService
@inject NavigationManager NavigationManager

<PageTitle>Semanas - Portal de Estudos C#</PageTitle>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white p-4">
                    <h2 class="mb-1">📅 Semanas do Curso</h2>
                    <p class="mb-0 opacity-75">Explore todas as semanas de estudo e acompanhe seu progresso</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Progress Overview -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-semibold">Progresso Geral</h6>
                        <span class="text-muted small">@stats.CompletedLessons de @stats.TotalLessons lições • @stats.CompletedExercises de @stats.TotalExercises exercícios</span>
                    </div>
                    <div class="progress" style="height: 12px; border-radius: 6px;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @stats.ProgressPercentage%; background: linear-gradient(90deg, #667eea, #764ba2); border-radius: 6px;"
                             aria-valuenow="@stats.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- WeekModel Cards Grid -->
    <div class="row">
        @foreach (var week in weeks)
        {
            var weekProgress = GetWeekProgress(week);
            var completedLessons = week.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
            var completedExercises = week.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
            var totalItems = week.Lessons.Count + week.Exercises.Count + (week.Challenge != null ? 1 : 0);
            var completedItems = completedLessons + completedExercises + (week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id) ? 1 : 0);
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm portal-card h-100" @onclick="() => NavigateToWeek(week.Id)" style="cursor: pointer;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="week-icon" style="width: 56px; height: 56px; background: rgba(102, 126, 234, 0.1); border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 28px;">@week.Icon</span>
                            </div>
                            @if (IsWeekCompleted(week))
                            {
                                <span class="badge bg-success rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i>Completa
                                </span>
                            }
                            else if (IsWeekInProgress(week))
                            {
                                <span class="badge bg-warning text-dark rounded-pill">
                                    <i class="bi bi-play-circle-fill me-1"></i>Em progresso
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">
                                    <i class="bi bi-circle me-1"></i>Não iniciada
                                </span>
                            }
                        </div>
                        <h5 class="card-title fw-semibold mb-1">Semana @week.Id</h5>
                        <h6 class="card-subtitle mb-2 text-primary">@week.Title</h6>
                        <p class="card-text text-muted small mb-3">@week.Description</p>

                        <!-- Progress bar for week -->
                        <div class="progress-bar-custom mb-3">
                            <div class="progress-bar" style="width: @weekProgress%;"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-book me-1"></i>@completedLessons/@week.Lessons.Count lições
                            </small>
                            <small class="text-muted">
                                <i class="bi bi-code-square me-1"></i>@completedExercises/@week.Exercises.Count exercícios
                            </small>
                        </div>
                        @if (week.Challenge != null)
                        {
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-trophy me-1"></i>Desafio disponível
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .portal-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .portal-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.12) !important;
    }
</style>

@code {
    private List<WeekModel> weeks = new();
    private DashboardStats stats = new();
    private UserProgress userProgress = new();

    protected override void OnInitialized()
    {
        weeks = ContentService.GetAllWeeks();
        stats = ContentService.GetDashboardStats(userProgress);
    }

    private double GetWeekProgress(WeekModel week)
    {
        var totalItems = week.Lessons.Count + week.Exercises.Count + (week.Challenge != null ? 1 : 0);
        if (totalItems == 0) return 0;

        var completedLessons = week.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
        var completedExercises = week.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
        var completedChallenge = week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id) ? 1 : 0;

        return Math.Round((double)(completedLessons + completedExercises + completedChallenge) / totalItems * 100, 1);
    }

    private bool IsWeekCompleted(WeekModel week)
    {
        var allLessonsCompleted = week.Lessons.All(l => userProgress.CompletedLessons.Contains(l.Id));
        var allExercisesCompleted = week.Exercises.All(e => userProgress.CompletedExercises.Contains(e.Id));
        var challengeCompleted = week.Challenge == null || userProgress.CompletedChallenges.Contains(week.Challenge.Id);

        return allLessonsCompleted && allExercisesCompleted && challengeCompleted;
    }

    private bool IsWeekInProgress(WeekModel week)
    {
        var hasStartedLessonModel = week.Lessons.Any(l => userProgress.CompletedLessons.Contains(l.Id));
        var hasStartedExerciseModel = week.Exercises.Any(e => userProgress.CompletedExercises.Contains(e.Id));
        var hasStartedChallenge = week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id);

        return hasStartedLessonModel || hasStartedExerciseModel || hasStartedChallenge;
    }

    private void NavigateToWeek(int weekId)
    {
        NavigationManager.NavigateTo($"/week/{weekId}");
    }
}