@page "/dashboard"
@using PortalEstudos.Models
@using PortalEstudos.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IContentService ContentService
@inject IProgressService ProgressService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard - Portal de Estudos C#</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">👋 Bem-vindo de volta!</MudText>

<!-- Card de boas-vindas + anel de progresso -->
<MudPaper Class="pa-6 mb-4" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
        <div>
            <MudText Typo="Typo.h5" Class="mb-1">Continue sua jornada em C# e .NET</MudText>
            <MudText>Você está indo muito bem! 🚀</MudText>
        </div>
        <MudProgressCircular Color="Color.Default" Size="Size.Large" Value="@stats.ProgressPercentage" Class="mud-theme-default">
            <MudText Style="color:white; font-weight:bold;">@stats.ProgressPercentage%</MudText>
        </MudProgressCircular>
    </div>
</MudPaper>

<!-- Barra de progresso geral -->
<MudPaper Class="pa-4 mb-4" Elevation="2">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Progresso Geral</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @stats.CompletedLessons de @stats.TotalLessons lições • @stats.CompletedExercises de @stats.TotalExercises exercícios
        </MudText>
    </div>
    <MudProgressLinear Color="Color.Primary" Value="@stats.ProgressPercentage" Rounded />
</MudPaper>

<!-- Stat cards -->
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">@stats.CompletedLessons</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Lições Concluídas</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Large" Color="Color.Success" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">@stats.CompletedExercises</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Exercícios Feitos</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">@stats.CompletedChallenges</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Desafios Completos</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h4" Class="mt-2 font-weight-bold">@stats.CurrentStreak</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Dias Seguidos</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Grade de semanas -->
<MudText Typo="Typo.h5" Class="mb-3">📅 Semanas do Curso</MudText>
<MudGrid Spacing="4">
    @foreach (var week in weeks)
    {
        <MudItem xs="12" md="6" lg="4">
            <MudCard Class="week-card-hover" Style="cursor:pointer;" onclick="@(() => NavigateToWeek(week.Id))">
                <MudCardContent>
                    <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                        <MudPaper Width="56" Height="56" Class="d-flex align-center justify-center" Style="background: rgba(102,126,234,0.1); border-radius:14px;">
                            <MudText Style="font-size:28px;">@week.Icon</MudText>
                        </MudPaper>
                        @if (IsWeekCompleted(week))
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Completa
                            </MudChip>
                        }
                        else if (IsWeekInProgress(week))
                        {
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mr-1" /> Em progresso
                            </MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-3 font-weight-bold">Semana @week.Id</MudText>
                    <MudText Typo="Typo.subtitle2" Class="primary-text">@week.Title</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Style="min-height:3rem;">@week.Description</MudText>
                    <MudDivider Class="my-2" />
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" /> @week.Lessons.Count lições
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" /> @week.Exercises.Count exercícios
                        </MudText>
                    </div>
                    @if (week.Challenge != null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" /> Desafio disponível
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<style>
    .week-card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .week-card-hover:hover { transform: translateY(-4px); box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.12); }
    .primary-text { color: var(--mud-palette-primary); }
</style>

@code {
    private List<WeekModel> weeks = new();
    private DashboardStats stats = new();
    private UserProgress userProgress = new();

    protected override async Task OnInitializedAsync()
    {
        userProgress = await ProgressService.LoadAsync();
        weeks = ContentService.GetAllWeeks();
        stats = ContentService.GetDashboardStats(userProgress);
    }

    private bool IsWeekCompleted(WeekModel week)
    {
        var allLessonsCompleted = week.Lessons.All(l => userProgress.CompletedLessons.Contains(l.Id));
        var allExercisesCompleted = week.Exercises.All(e => userProgress.CompletedExercises.Contains(e.Id));
        var challengeCompleted = week.Challenge == null || userProgress.CompletedChallenges.Contains(week.Challenge.Id);

        return allLessonsCompleted && allExercisesCompleted && challengeCompleted;
    }

    private bool IsWeekInProgress(WeekModel week)
    {
        var hasStartedLessonModel = week.Lessons.Any(l => userProgress.CompletedLessons.Contains(l.Id));
        var hasStartedExerciseModel = week.Exercises.Any(e => userProgress.CompletedExercises.Contains(e.Id));
        var hasStartedChallenge = week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id);

        return hasStartedLessonModel || hasStartedExerciseModel || hasStartedChallenge;
    }

    private void NavigateToWeek(int weekId)
    {
        NavigationManager.NavigateTo($"/week/{weekId}");
    }
}
