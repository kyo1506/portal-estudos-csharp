@page "/week/{weekId}/lesson/{lessonId}"
@using PortalEstudos.Models
@using PortalEstudos.Services
@using MudBlazor
@inject IContentService ContentService
@inject IProgressService ProgressService
@inject NavigationManager NavigationManager

<PageTitle>@lesson?.Title - Portal de Estudos C#</PageTitle>

@if (lesson == null || week == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="3">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" Class="mb-2">Lição não encontrada</MudText>
        <MudText Class="mud-text-secondary mb-4">A lição que você procura não existe.</MudText>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="NavigateToWeek">Voltar para Semana</MudButton>
    </MudPaper>
}
else
{
    <MudBreadcrumbs Class="mb-3">
        <MudLink Href="/weeks">Semanas</MudLink>
        <MudLink Href="@($"/week/{week.Id}")">Semana @week.Id</MudLink>
        <MudText>Lição @lesson.Order</MudText>
    </MudBreadcrumbs>

    <MudGrid Spacing="4">
        <!-- Conteúdo da lição -->
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4" Elevation="2">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                    <MudText Typo="Typo.h4" Class="font-weight-bold">📖 @lesson.Title</MudText>
                    @if (userProgress.CompletedLessons.Contains(lesson.Id))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Concluída
                        </MudChip>
                    }
                </div>
                <MudDivider Class="mb-3" />
                <div class="markdown-content">
                    @((MarkupString)ConvertMarkdownToHtml(lesson.Content))
                </div>
            </MudPaper>

            @if (!string.IsNullOrEmpty(lesson.CodeExample))
            {
                <MudPaper Class="mt-4" Elevation="2">
                    <MudToolBar Class="pa-2" Style="background:#1e1e2e; color:white;">
                        <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />
                        <MudText>Exemplo de Código</MudText>
                        <MudSpacer />
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">@(lesson.CodeLanguage ?? "csharp")</MudChip>
                    </MudToolBar>
                    <div class="code-block">@lesson.CodeExample</div>
                </MudPaper>
            }
        </MudItem>

        <!-- Sidebar -->
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-3 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" />Lições da Semana
                </MudText>
                <MudList T="LessonModel" Dense>
                    @foreach (var l in week.Lessons.OrderBy(l => l.Order))
                    {
                        <MudListItem T="LessonModel"
                                     Href="@($"/week/{week.Id}/lesson/{l.Id}")"
                                     Icon="@(l.Id == lesson.Id ? Icons.Material.Filled.MenuBook : Icons.Material.Filled.BookmarkBorder)"
                                     IconColor="@(l.Id == lesson.Id ? Color.Primary : Color.Default)">
                            <div style="display:flex; align-items:center; width:100%;">
                                <MudText Class="@(l.Id == lesson.Id ? "font-weight-bold" : "")">@l.Title</MudText>
                                @if (userProgress.CompletedLessons.Contains(l.Id))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="ml-auto" />
                                }
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="2">
                @if (userProgress.CompletedLessons.Contains(lesson.Id))
                {
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" FullWidth Class="mb-2" StartIcon="@Icons.Material.Filled.Refresh" OnClick="MarkAsIncomplete">
                        Marcar como não concluída
                    </MudButton>
                }
                else
                {
                    <MudButton Color="Color.Success" Variant="Variant.Filled" FullWidth Class="mb-2" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="MarkAsComplete">
                        Marcar como concluída
                    </MudButton>
                }
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" FullWidth Disabled="@(GetPreviousLessonId() == null)" StartIcon="@Icons.Material.Filled.ChevronLeft" OnClick="NavigateToPreviousLesson" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" FullWidth Disabled="@(GetNextLessonId() == null)" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="NavigateToNextLesson" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .markdown-content { line-height: 1.8; }
    .markdown-content h2 { color: #764ba2; margin-top: 1.5rem; margin-bottom: 1rem; font-weight: 600; }
    .markdown-content h3 { margin-top: 1.25rem; margin-bottom: 0.75rem; font-weight: 600; }
    .markdown-content p { margin-bottom: 1rem; }
    .markdown-content ul, .markdown-content ol { margin-bottom: 1rem; padding-left: 1.5rem; }
</style>

@code {
    private WeekModel? week;
    private Models.LessonModel? lesson;
    private UserProgress userProgress = new();

    [Parameter]
    public string? WeekId { get; set; }

    [Parameter]
    public string? LessonId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(WeekId, out int weekId) && int.TryParse(LessonId, out int lessonId))
        {
            week = ContentService.GetWeek(weekId);
            lesson = ContentService.GetLesson(weekId, lessonId);
        }
        userProgress = await ProgressService.LoadAsync();
    }

    private string ConvertMarkdownToHtml(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;

        var html = System.Net.WebUtility.HtmlEncode(markdown);

        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"```(\w*)\r?\n(.*?)```",
            "<pre><code class=\"language-$1\">$2</code></pre>",
            System.Text.RegularExpressions.RegexOptions.Singleline);

        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"`([^`]+)`",
            "<code>$1</code>");

        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h2>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h3>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        html = html.Replace("\r\n", "\n").Replace("\n\n", "</p><p>").Replace("\n", "<br/>");
        html = $"<p>{html}</p>";

        html = html.Replace("<p></p>", "");
        html = html.Replace("<p><h2>", "<h2>").Replace("</h2></p>", "</h2>");
        html = html.Replace("<p><h3>", "<h3>").Replace("</h3></p>", "</h3>");
        html = html.Replace("<p><pre>", "<pre>").Replace("</pre></p>", "</pre>");

        return html;
    }

    private int? GetPreviousLessonId()
    {
        if (week == null || lesson == null) return null;
        var orderedLessons = week.Lessons.OrderBy(l => l.Order).ToList();
        var currentIndex = orderedLessons.FindIndex(l => l.Id == lesson.Id);
        return currentIndex > 0 ? orderedLessons[currentIndex - 1].Id : null;
    }

    private int? GetNextLessonId()
    {
        if (week == null || lesson == null) return null;
        var orderedLessons = week.Lessons.OrderBy(l => l.Order).ToList();
        var currentIndex = orderedLessons.FindIndex(l => l.Id == lesson.Id);
        return currentIndex < orderedLessons.Count - 1 ? orderedLessons[currentIndex + 1].Id : null;
    }

    private async Task MarkAsComplete()
    {
        if (lesson != null)
        {
            await ProgressService.MarkLessonCompleteAsync(lesson.Id);
            userProgress = await ProgressService.LoadAsync();
            StateHasChanged();
        }
    }

    private async Task MarkAsIncomplete()
    {
        if (lesson != null)
        {
            await ProgressService.MarkLessonIncompleteAsync(lesson.Id);
            userProgress = await ProgressService.LoadAsync();
            StateHasChanged();
        }
    }

    private void NavigateToWeek()
    {
        NavigationManager.NavigateTo($"/week/{WeekId}");
    }

    private void NavigateToPreviousLesson()
    {
        var prevId = GetPreviousLessonId();
        if (prevId != null)
        {
            NavigationManager.NavigateTo($"/week/{WeekId}/lesson/{prevId}");
        }
    }

    private void NavigateToNextLesson()
    {
        var nextId = GetNextLessonId();
        if (nextId != null)
        {
            NavigationManager.NavigateTo($"/week/{WeekId}/lesson/{nextId}");
        }
    }
}
