@page "/week/{id}"
@using PortalEstudos.Models
@using PortalEstudos.Services
@using MudBlazor
@using Markdig
@inject IContentService ContentService
@inject IProgressService ProgressService
@inject IGitHubService GitHubService
@inject NavigationManager NavigationManager

<PageTitle>Semana @week?.Id - Portal de Estudos C#</PageTitle>

@if (isLoading)
{
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-4" />
        </MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
    </MudGrid>
}
else if (week == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="3">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" Class="mb-2">Semana não encontrada</MudText>
        <MudText Class="mud-text-secondary mb-4">A semana que você procura não existe.</MudText>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="NavigateToWeeks">Voltar para Semanas</MudButton>
    </MudPaper>
}
else
{
    <!-- Cabeçalho -->
    <MudPaper Class="pa-6 mb-4" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
            <div>
                <MudBreadcrumbs Class="mb-2">
                    <MudLink Href="/weeks" Style="color: rgba(255,255,255,0.75);">Semanas</MudLink>
                    <MudText Style="color: white;">Semana @week.Id</MudText>
                </MudBreadcrumbs>
                <MudText Typo="Typo.h4" Class="font-weight-bold">@week.Icon Semana @week.Id: @week.Title</MudText>
                <MudText>@week.Description</MudText>
            </div>
            <MudProgressCircular Color="Color.Default" Size="Size.Large" Value="@weekProgress">
                <MudText Style="color:white; font-weight:bold;">@weekProgress%</MudText>
            </MudProgressCircular>
        </div>
    </MudPaper>

    <!-- Lições -->
    <MudText Typo="Typo.h5" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2" /> Lições (@completedLessons/@week.Lessons.Count)
    </MudText>
    <MudGrid Spacing="3" Class="mb-4" AlignItems="AlignItems.Stretch">
        @foreach (var lesson in week.Lessons.OrderBy(l => l.Order))
        {
            var done = userProgress.CompletedLessons.Contains(lesson.Id);
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <a href="@($"/week/{week.Id}/lesson/{lesson.Id}")" class="week-card-link">
                    <MudCard Class="week-card-hover flex-fill" Style="width:100%;">
                        <MudCardContent>
                            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">@lesson.Order</MudAvatar>
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@lesson.Title</MudText>
                                </div>
                                <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@(done ? Color.Success : Color.Default)" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@GetLessonPreview(lesson)</MudText>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        }
    </MudGrid>

    <!-- Exercícios -->
    <MudText Typo="Typo.h5" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" /> Exercícios (@completedExercises/@week.Exercises.Count)
    </MudText>
    <MudGrid Spacing="3" Class="mb-4" AlignItems="AlignItems.Stretch">
        @foreach (var exercise in week.Exercises)
        {
            var done = userProgress.CompletedExercises.Contains(exercise.Id);
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <a href="@($"/week/{week.Id}/exercise/{exercise.Id}")" class="week-card-link">
                    <MudCard Class="week-card-hover flex-fill" Style="width:100%;">
                        <MudCardContent>
                            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@exercise.Title</MudText>
                                <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@(done ? Color.Success : Color.Default)" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-2">@exercise.Description</MudText>
                            <MudChip T="string" Color="@GetDifficultyColor(exercise.Difficulty)" Variant="Variant.Filled" Size="Size.Small">
                                @GetDifficultyText(exercise.Difficulty)
                            </MudChip>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        }
    </MudGrid>

    <!-- Desafio -->
    @if (week.Challenge != null)
    {
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" /> Desafio da Semana
        </MudText>
        <MudPaper Class="pa-4" Elevation="2">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
                <div style="flex:1; min-width:280px;">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">@week.Challenge.Title</MudText>
                    <MudText Class="mud-text-secondary mb-2">@week.Challenge.Description</MudText>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Requisitos:</MudText>
                    <MudList T="string" Dense>
                        @foreach (var req in week.Challenge.Requirements)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Secondary">@req</MudListItem>
                        }
                    </MudList>
                </div>
                <div style="display:flex; flex-direction:column; gap:0.5rem; align-items:flex-start;">
                    @if (userProgress.CompletedChallenges.Contains(week.Challenge.Id))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Completo
                        </MudChip>
                    }
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@week.Challenge.GitHubUrl" Target="_blank">
                        Ver no GitHub
                    </MudButton>
                    @foreach (var pr in challengePrStatuses.Where(p => p.ChallengeId == week.Challenge.Id))
                    {
                        @if (pr.State == "merged")
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.Merge" Class="mr-1" /> PR Aprovado
                            </MudChip>
                        }
                        else if (pr.State == "open")
                        {
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.CallMerge" Class="mr-1" /> PR Aberto
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-1" /> PR Fechado
                            </MudChip>
                        }
                    }
                </div>
            </div>
        </MudPaper>
    }
}

<style>
    .week-card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .week-card-hover:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1); }
</style>

@code {
    private bool isLoading = true;
    private WeekModel? week;
    private UserProgress userProgress = new();
    private int weekProgress = 0;
    private int completedLessons = 0;
    private int completedExercises = 0;
    private List<ChallengePrStatus> challengePrStatuses = new();

    [Parameter]
    public string? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out int weekId))
        {
            userProgress = await ProgressService.LoadAsync();
            week = ContentService.GetWeek(weekId);
            if (week != null)
            {
                CalculateProgress();
                if (week.Challenge != null)
                {
                    challengePrStatuses = await GitHubService.GetChallengePrStatusAsync();
                }
            }
        }
        isLoading = false;
    }

    private void CalculateProgress()
    {
        if (week == null) return;

        completedLessons = week.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
        completedExercises = week.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
        var completedChallenge = week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id) ? 1 : 0;

        var totalItems = week.Lessons.Count + week.Exercises.Count + (week.Challenge != null ? 1 : 0);
        weekProgress = totalItems > 0 ? (int)Math.Round((double)(completedLessons + completedExercises + completedChallenge) / totalItems * 100) : 0;
    }

    private string GetLessonPreview(LessonModel lesson)
    {
        if (string.IsNullOrEmpty(lesson.Content)) return string.Empty;
        // Extrai o primeiro parágrafo de texto real (sem headers/code) usando Markdig
        var plain = Markdown.ToPlainText(lesson.Content).Replace("\r\n", " ").Replace("\n", " ").Trim();
        // Remove sobras de headers digitados colados (ex.: "## X ### Y")
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"#+\s*", "");
        if (plain.Length > 110)
            plain = plain[..110].Trim() + "...";
        return plain;
    }

    private Color GetDifficultyColor(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => Color.Success,
        ExerciseDifficulty.Medium => Color.Warning,
        ExerciseDifficulty.Hard => Color.Error,
        _ => Color.Default
    };

    private string GetDifficultyText(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => "Fácil",
        ExerciseDifficulty.Medium => "Médio",
        ExerciseDifficulty.Hard => "Difícil",
        _ => "Desconhecido"
    };

    private void NavigateToWeeks()
    {
        NavigationManager.NavigateTo("/weeks");
    }

    private void NavigateToLesson(int lessonId)
    {
        NavigationManager.NavigateTo($"/week/{Id}/lesson/{lessonId}");
    }

    private void NavigateToExercise(int exerciseId)
    {
        NavigationManager.NavigateTo($"/week/{Id}/exercise/{exerciseId}");
    }
}
