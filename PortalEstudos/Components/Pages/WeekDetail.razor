@page "/week/{id}"
@using PortalEstudos.Models
@using PortalEstudos.Services
@inject IContentService ContentService
@inject NavigationManager NavigationManager

<PageTitle>Semana @week?.Id - Portal de Estudos C#</PageTitle>

@if (week == null)
{
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-5">
                        <div style="font-size: 4rem;" class="mb-3">🔍</div>
                        <h4>Semana não encontrada</h4>
                        <p class="text-muted">A semana que você está procurando não existe.</p>
                        <button class="btn btn-primary" @onclick="NavigateToWeeks">
                            <i class="bi bi-arrow-left me-1"></i>Voltar para Semanas
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">
        <!-- WeekModel Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="card-body text-white p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb mb-2" style="--bs-breadcrumb-divider: '>';">
                                        <li class="breadcrumb-item">
                                            <a href="/weeks" class="text-white opacity-75">Semanas</a>
                                        </li>
                                        <li class="breadcrumb-item active text-white" aria-current="page">Semana @week.Id</li>
                                    </ol>
                                </nav>
                                <h2 class="mb-1">@week.Icon Semana @week.Id: @week.Title</h2>
                                <p class="mb-0 opacity-75">@week.Description</p>
                            </div>
                            <div class="d-none d-md-flex align-items-center justify-content-center">
                                <svg width="100" height="100" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="44" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="6" />
                                    <circle cx="50" cy="50" r="44" fill="none" stroke="white" stroke-width="6"
                                            stroke-dasharray="276.46" stroke-dashoffset="@(276.46 - (276.46 * weekProgress / 100))"
                                            stroke-linecap="round" transform="rotate(-90 50 50)" />
                                    <text x="50" y="48" text-anchor="middle" fill="white" font-size="20" font-weight="bold">@weekProgress%</text>
                                    <text x="50" y="65" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="10">completo</text>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lessons Section -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-book me-2"></i>Lições (@completedLessons/@week.Lessons.Count)
                </h5>
            </div>
            @foreach (var lesson in week.Lessons.OrderBy(l => l.Order))
            {
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <div class="card border-0 shadow-sm portal-card h-100" @onclick="() => NavigateToLesson(lesson.Id)" style="cursor: pointer;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-primary rounded-circle me-2" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">@lesson.Order</span>
                                    <h6 class="mb-0 fw-semibold">@lesson.Title</h6>
                                </div>
                                @if (userProgress.CompletedLessons.Contains(lesson.Id))
                                {
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 1.2rem;"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted" style="font-size: 1.2rem;"></i>
                                }
                            </div>
                            <p class="text-muted small mb-0">@GetLessonPreview(lesson)</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Exercises Section -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-code-square me-2"></i>Exercícios (@completedExercises/@week.Exercises.Count)
                </h5>
            </div>
            @foreach (var exercise in week.Exercises)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <div class="card border-0 shadow-sm portal-card h-100" @onclick="() => NavigateToExercise(exercise.Id)" style="cursor: pointer;">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <h6 class="mb-0 fw-semibold">@exercise.Title</h6>
                                @if (userProgress.CompletedExercises.Contains(exercise.Id))
                                {
                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 1.2rem;"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted" style="font-size: 1.2rem;"></i>
                                }
                            </div>
                            <p class="text-muted small mb-2">@exercise.Description</p>
                            <span class="badge @GetDifficultyBadgeClass(exercise.Difficulty) rounded-pill">
                                @GetDifficultyText(exercise.Difficulty)
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Challenge Section -->
        @if (week.Challenge != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <h5 class="fw-semibold mb-3">
                        <i class="bi bi-trophy me-2"></i>Desafio da Semana
                    </h5>
                </div>
                <div class="col-12">
                    <div class="card border-0 shadow-sm challenge-card">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div>
                                    <h5 class="fw-semibold mb-1">@week.Challenge.Title</h5>
                                    <p class="text-muted mb-2">@week.Challenge.Description</p>
                                </div>
                                @if (userProgress.CompletedChallenges.Contains(week.Challenge.Id))
                                {
                                    <span class="badge bg-success rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Completo
                                    </span>
                                }
                            </div>
                            <h6 class="fw-semibold mb-2">Requisitos:</h6>
                            <ul class="mb-3">
                                @foreach (var req in week.Challenge.Requirements)
                                {
                                    <li class="text-muted small">@req</li>
                                }
                            </ul>
                            <a href="@week.Challenge.GitHubUrl" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-github me-1"></i>Ver no GitHub
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .portal-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .portal-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255,255,255,0.5);
    }
</style>

@code {
    private WeekModel? week;
    private UserProgress userProgress = new();
    private int weekProgress = 0;
    private int completedLessons = 0;
    private int completedExercises = 0;

    [Parameter]
    public string? Id { get; set; }

    protected override void OnInitialized()
    {
        if (int.TryParse(Id, out int weekId))
        {
            week = ContentService.GetWeek(weekId);
            if (week != null)
            {
                CalculateProgress();
            }
        }
    }

    private void CalculateProgress()
    {
        if (week == null) return;

        completedLessons = week.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
        completedExercises = week.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
        var completedChallenge = week.Challenge != null && userProgress.CompletedChallenges.Contains(week.Challenge.Id) ? 1 : 0;

        var totalItems = week.Lessons.Count + week.Exercises.Count + (week.Challenge != null ? 1 : 0);
        weekProgress = totalItems > 0 ? (int)Math.Round((double)(completedLessons + completedExercises + completedChallenge) / totalItems * 100) : 0;
    }

    private string GetLessonPreview(LessonModel lesson)
    {
        if (string.IsNullOrEmpty(lesson.Content)) return string.Empty;
        var preview = lesson.Content.Replace("\r\n", " ").Replace("\n", " ");
        return preview.Length > 100 ? preview[..100] + "..." : preview;
    }

    private string GetDifficultyBadgeClass(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => "bg-success",
        ExerciseDifficulty.Medium => "bg-warning text-dark",
        ExerciseDifficulty.Hard => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetDifficultyText(ExerciseDifficulty difficulty) => difficulty switch
    {
        ExerciseDifficulty.Easy => "Fácil",
        ExerciseDifficulty.Medium => "Médio",
        ExerciseDifficulty.Hard => "Difícil",
        _ => "Desconhecido"
    };

    private void NavigateToWeeks()
    {
        NavigationManager.NavigateTo("/weeks");
    }

    private void NavigateToLesson(int lessonId)
    {
        NavigationManager.NavigateTo($"/week/{Id}/lesson/{lessonId}");
    }

    private void NavigateToExercise(int exerciseId)
    {
        NavigationManager.NavigateTo($"/week/{Id}/exercise/{exerciseId}");
    }
}