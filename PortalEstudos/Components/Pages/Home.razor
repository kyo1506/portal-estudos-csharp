@page "/"
@using MudBlazor
@using PortalEstudos.Services
@inject NavigationManager NavigationManager
@inject IProgressService ProgressService
@inject IContentService ContentService

<PageTitle>Portal de Estudos - C# e .NET</PageTitle>

@if (stats == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate Class="my-8" />
}
else
{
    <!-- Hero -->
    <MudPaper Class="pa-8 mb-6" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 1rem;">
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.h3" Class="font-weight-bold mb-3">🚀 Aprenda C# de verdade</MudText>
                <MudText Typo="Typo.subtitle1" Class="mb-6" Style="opacity:0.9;">
                    Um portal de estudos interativo com teoria, exemplos práticos e exercícios
                    para dominar os fundamentos do C# e .NET 10 — no seu ritmo, com acompanhamento de progresso.
                </MudText>
                <div style="display:flex; gap:1rem; flex-wrap:wrap;">
                    <MudButton Color="Color.Surface" Variant="Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Filled.School" OnClick="NavigateToWeeks">
                        Começar a Estudar
                    </MudButton>
                    <MudButton Color="Color.Default" Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Filled.Insights" OnClick="NavigateToDashboard" Style="color:white; border-color:rgba(255,255,255,0.6);">
                        Ver Progresso
                    </MudButton>
                </div>
            </MudItem>
            <MudItem xs="12" md="5" Class="d-flex align-center justify-center">
                <div style="font-size:7rem;">📚</div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Estatísticas -->
    <MudGrid Spacing="4" Class="mb-6">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#667eea;">@stats.TotalWeeks</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Semanas</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#28a745;">@stats.CompletedLessons/@stats.TotalLessons</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Lições</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#764ba2;">@stats.CompletedExercises/@stats.TotalExercises</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Exercícios</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color:#fd7e14;">@stats.ProgressPercentage%</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Progresso</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="4">
        <!-- Como funciona -->
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5" Class="mb-3 font-weight-bold">Como funciona</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6" Class="d-flex">
                    <MudPaper Class="pa-4 flex-fill" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">1. Teoria</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Conceitos explicados com exemplos de código reais em C#.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex">
                    <MudPaper Class="pa-4 flex-fill" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">2. Exercícios</MudText>
                        <MudText Typo="Typo.body2" class="mud-text-secondary">Pratique escrevendo código e verifique a saída esperada.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex">
                    <MudPaper Class="pa-4 flex-fill" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Class="mb-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">3. Desafios</MudText>
                        <MudText Typo="Typo.body2" class="mud-text-secondary">Projeto semanal via Pull Request no GitHub para code review.</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex">
                    <MudPaper Class="pa-4 flex-fill" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Color="Color.Info" Class="mb-2" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">4. Progresso</MudText>
                        <MudText Typo="Typo.body2" class="mud-text-secondary">Acompanhe lições e exercícios concluídos em um painel.</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>

        <!-- CTA lateral -->
        <MudItem xs="12" md="4" Class="d-flex">
            <MudPaper Class="pa-4 text-center flex-fill d-flex flex-column" Elevation="3" Style="border-top:4px solid var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.Whatshot" Color="Color.Secondary" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">Pronta para começar?</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Explore as semanas do curso e avance no seu ritmo.</MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth Size="Size.Large" OnClick="NavigateToWeeks" Class="mt-auto">
                    Ver Semanas
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var progress = await ProgressService.LoadAsync();
        stats = ContentService.GetDashboardStats(progress);
    }

    private void NavigateToWeeks() => NavigationManager.NavigateTo("/weeks");
    private void NavigateToDashboard() => NavigationManager.NavigateTo("/dashboard");
}
