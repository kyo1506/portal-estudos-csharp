@page "/fase/{id}"
@using MudBlazor
@using PortalEstudos.Domain.Enums
@using PortalEstudos.Web.Presentation
@inject ICatalogService CatalogService
@inject IDashboardService DashboardService
@inject IProgressService ProgressService
@inject IChallengeStatusService ChallengeStatusService
@inject IMarkdownRenderer MarkdownRenderer
@inject NavigationManager NavigationManager

<PageTitle>Fase @fase?.Id - Portal de Estudos C#</PageTitle>
<HeadContent>
    <meta name="description" content="Fase @fase?.Id do curso de C# e .NET: lições, exercícios e desafio prático com progresso acompanhado." />
</HeadContent>

@if (isLoading)
{
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-4" />
        </MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
        <MudItem xs="12" md="6" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="140px" /></MudItem>
    </MudGrid>
}
else if (fase == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="3">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" Class="mb-2">Fase não encontrada</MudText>
        <MudText Class="mud-text-secondary mb-4">A fase que você procura não existe.</MudText>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/fases">Voltar para Fases</MudButton>
    </MudPaper>
}
else
{
    <!-- Cabeçalho -->
    <MudPaper Class="pa-6 mb-4" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
            <div>
                <div class="mb-2 breadcrumb-row">
                    <MudLink Href="/fases" Style="color: rgba(255,255,255,0.75);">Fases</MudLink>
                    <span class="breadcrumb-sep">/</span>
                    <span style="color: white;">Fase @fase.Id</span>
                </div>
                <MudText Typo="Typo.h4" Class="font-weight-bold">@fase.Icon Fase @fase.Id: @fase.Title</MudText>
                <MudText>@fase.Description</MudText>
            </div>
            <MudProgressCircular Color="Color.Default" Size="Size.Large" Value="@faseProgress">
                <MudText Style="color:white; font-weight:bold;">@faseProgress%</MudText>
            </MudProgressCircular>
        </div>
    </MudPaper>

    <!-- Lições -->
    <MudText Typo="Typo.h5" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2" /> Lições (@completedLessons/@fase.Lessons.Count)
    </MudText>
    <MudGrid Spacing="3" Class="mb-4 stretch-grid">
        @foreach (var lesson in fase.Lessons.OrderBy(l => l.Order))
        {
            var done = userProgress.CompletedLessons.Contains(lesson.Id);
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <a href="@($"/fase/{fase.Id}/lesson/{lesson.Id}")" class="fase-card-link">
                    <MudCard Class="fase-card-hover flex-fill" Style="width:100%;">
                        <MudCardContent>
                            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">@lesson.Order</MudAvatar>
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@lesson.Title</MudText>
                                </div>
                                <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@(done ? Color.Success : Color.Default)" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@GetLessonPreview(lesson)</MudText>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        }
    </MudGrid>

    <!-- Exercícios -->
    <MudText Typo="Typo.h5" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" /> Exercícios (@completedExercises/@fase.Exercises.Count)
    </MudText>
    <MudGrid Spacing="3" Class="mb-4 stretch-grid">
        @foreach (var exercise in fase.Exercises)
        {
            var done = userProgress.CompletedExercises.Contains(exercise.Id);
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <a href="@($"/fase/{fase.Id}/exercise/{exercise.Id}")" class="fase-card-link">
                    <MudCard Class="fase-card-hover flex-fill" Style="width:100%;">
                        <MudCardContent>
                            <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@exercise.Title</MudText>
                                <MudIcon Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@(done ? Color.Success : Color.Default)" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-2">@exercise.Description</MudText>
                            <MudChip T="string" Color="@DifficultyPresentation.GetColor(exercise.Difficulty)" Variant="Variant.Filled" Size="Size.Small">
                                @DifficultyPresentation.GetText(exercise.Difficulty)
                            </MudChip>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        }
    </MudGrid>

    <!-- Desafio -->
    @if (fase.Challenge != null)
    {
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" /> Desafio da Fase
        </MudText>
        <MudPaper Class="pa-4" Elevation="2">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
                <div style="flex:1; min-width:280px;">
                    <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">@fase.Challenge.Title</MudText>
                    <MudText Class="mud-text-secondary mb-2">@fase.Challenge.Description</MudText>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Requisitos:</MudText>
                    <MudList T="string" Dense>
                        @foreach (var req in fase.Challenge.Requirements)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Secondary">@req</MudListItem>
                        }
                    </MudList>
                </div>
                <div style="display:flex; flex-direction:column; gap:0.5rem; align-items:flex-start;">
                    @if (userProgress.CompletedChallenges.Contains(fase.Challenge.Id))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Completo
                        </MudChip>
                    }
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@fase.Challenge.GitHubUrl" Target="_blank">
                        Ver no GitHub
                    </MudButton>
                    @foreach (var pr in challengePrStatuses.Where(p => p.ChallengeId == fase.Challenge.Id))
                    {
                        @if (pr.State == "merged")
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.Merge" Class="mr-1" /> PR Aprovado
                            </MudChip>
                        }
                        else if (pr.State == "open")
                        {
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.CallMerge" Class="mr-1" /> PR Aberto
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" title="@pr.Title">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-1" /> PR Fechado
                            </MudChip>
                        }
                    }
                </div>
            </div>
        </MudPaper>
    }
}

<style>
    .fase-card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .fase-card-hover:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1); }
    .stretch-grid { align-items: stretch; }
    .breadcrumb-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
    .breadcrumb-sep { color: rgba(255,255,255,0.5); }
</style>

@code {
    private bool isLoading = true;
    private Fase? fase;
    private UserProgress userProgress = new();
    private int faseProgress = 0;
    private int completedLessons = 0;
    private int completedExercises = 0;
    private IReadOnlyList<ChallengePrStatus> challengePrStatuses = new List<ChallengePrStatus>();
    private string? _loadedKey;
    private int _loadToken;

    [Parameter]
    public string? Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var key = Id ?? "";
        var token = ++_loadToken;

        // Reage à troca do parâmetro de rota (OnParametersSetAsync), não apenas à inicialização.
        if (_loadedKey == key)
            return;

        _loadedKey = key;
        isLoading = true;
        StateHasChanged();

        fase = null;
        challengePrStatuses = new List<ChallengePrStatus>();
        if (int.TryParse(Id, out int faseId))
        {
            userProgress = await ProgressService.LoadAsync();
            fase = CatalogService.GetFase(faseId);
            if (fase != null)
            {
                CalculateProgress();
                if (fase.Challenge != null)
                {
                    challengePrStatuses = await ChallengeStatusService.GetAsync();
                }
            }
        }

        if (token == _loadToken)
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateProgress()
    {
        if (fase == null) return;

        completedLessons = fase.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
        completedExercises = fase.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
        faseProgress = (int)Math.Round(DashboardService.GetFaseProgress(fase, userProgress));
    }

    private string GetLessonPreview(LessonModel lesson)
    {
        if (string.IsNullOrEmpty(lesson.Content)) return string.Empty;
        // Extrai o primeiro parágrafo de texto real (sem headers/code).
        var plain = MarkdownRenderer.ToPlainText(lesson.Content).Replace("\r\n", " ").Replace("\n", " ").Trim();
        // Remove sobras de headers digitados colados (ex.: "## X ### Y").
        plain = System.Text.RegularExpressions.Regex.Replace(plain, @"#+\s*", "");
        if (plain.Length > 110)
            plain = plain[..110].Trim() + "...";
        return plain;
    }

    private void NavigateToFases()
    {
        NavigationManager.NavigateTo("/fases");
    }

    private void NavigateToLesson(int lessonId)
    {
        NavigationManager.NavigateTo($"/fase/{Id}/lesson/{lessonId}");
    }

    private void NavigateToExercise(int exerciseId)
    {
        NavigationManager.NavigateTo($"/fase/{Id}/exercise/{exerciseId}");
    }
}
