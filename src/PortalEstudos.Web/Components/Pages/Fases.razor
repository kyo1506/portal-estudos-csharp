@page "/fases"
@using MudBlazor
@inject ICatalogService CatalogService
@inject IDashboardService DashboardService
@inject IProgressService ProgressService
@inject NavigationManager NavigationManager

<PageTitle>Fases - Portal de Estudos C#</PageTitle>
<HeadContent>
    <meta name="description" content="As 4 fases do curso de C# e .NET: memória e tipos, orientação a objetos, coleções e LINQ, e tópicos avançados." />
</HeadContent>

<MudText Typo="Typo.h4" Class="mb-4">📅 Fases do Curso</MudText>

@if (isLoading)
{
    <!-- Skeleton do painel de progresso geral -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="180px" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" />
        </div>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="8px" Style="border-radius:4px;" />
    </MudPaper>

    <!-- Skeleton dos cards de fase -->
    <MudGrid Spacing="4">
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <MudPaper Class="flex-fill" Elevation="2" Style="width:100%; padding:1rem;">
                    <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="56px" Height="56px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                    </div>
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Class="mt-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" Class="mt-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="8px" Style="border-radius:4px; margin:0.75rem 0;" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <!-- Barra de progresso geral -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Progresso Geral</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @stats.CompletedLessons de @stats.TotalLessons lições • @stats.CompletedExercises de @stats.TotalExercises exercícios
            </MudText>
        </div>
        <MudProgressLinear Color="Color.Primary" Value="@stats.ProgressPercentage" Rounded />
    </MudPaper>

    <MudGrid Spacing="4">
        @foreach (var fase in fases)
        {
            var faseProgress = GetFaseProgress(fase);
            var completedLessons = fase.Lessons.Count(l => userProgress.CompletedLessons.Contains(l.Id));
            var completedExercises = fase.Exercises.Count(e => userProgress.CompletedExercises.Contains(e.Id));
            var faseChallengeDone = fase.Challenge != null && userProgress.CompletedChallenges.Contains(fase.Challenge.Id);
            <MudItem xs="12" md="6" lg="4" Class="d-flex">
                <MudCard Class="fase-card-hover flex-fill" Style="cursor:pointer; width:100%;"
                         onclick="@(() => NavigateToFase(fase.Id))"
                         onkeydown="@((Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) => OnCardKeyDown(e, fase.Id))"
                         role="button" tabindex="0"
                         aria-label="@($"Fase {fase.Id}: {fase.Title} — {(int)GetFaseProgress(fase)}% concluída")">
                    <MudCardContent>
                        <div style="display:flex; align-items:flex-start; justify-content:space-between;">
                            <MudPaper Width="56" Height="56" Class="d-flex align-center justify-center" Style="background: rgba(102,126,234,0.1); border-radius:14px;">
                                <MudText Style="font-size:28px;">@fase.Icon</MudText>
                            </MudPaper>
                            <div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem;">
                                <MudProgressCircular Color="@(IsFaseCompleted(fase) ? Color.Success : Color.Primary)" Size="Size.Small" Value="@((int)faseProgress)">
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">@((int)faseProgress)%</MudText>
                                </MudProgressCircular>
                                @if (IsFaseCompleted(fase))
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Completa
                                    </MudChip>
                                }
                                else if (IsFaseInProgress(fase))
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mr-1" /> Em progresso
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                                        <MudIcon Icon="@Icons.Material.Filled.Circle" Class="mr-1" /> Não iniciada
                                    </MudChip>
                                }
                            </div>
                        </div>
                        <MudText Typo="Typo.h6" Class="mt-3 font-weight-bold">Fase @fase.Id</MudText>
                        <MudText Typo="Typo.subtitle2" Class="primary-text">@fase.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Style="min-height:3rem;">@fase.Description</MudText>
                        <MudProgressLinear Color="Color.Primary" Value="@((int)faseProgress)" Class="my-2" Rounded />
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" /> @completedLessons/@fase.Lessons.Count lições
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" /> @completedExercises/@fase.Exercises.Count exercícios
                            </MudText>
                        </div>
                        @if (fase.Challenge != null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" /> Desafio @(faseChallengeDone ? "concluído" : "disponível")
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<style>
    .fase-card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .fase-card-hover:hover { transform: translateY(-4px); box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.12); }
    .primary-text { color: var(--mud-palette-primary); }
</style>

@code {
    private List<Fase> fases = new();
    private DashboardStats stats = new();
    private UserProgress userProgress = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        userProgress = await ProgressService.LoadAsync();
        fases = CatalogService.GetAllFases().ToList();
        stats = DashboardService.GetStats(userProgress);
        isLoading = false;
    }

    private double GetFaseProgress(Fase fase) => DashboardService.GetFaseProgress(fase, userProgress);

    private bool IsFaseCompleted(Fase fase) => DashboardService.IsFaseCompleted(fase, userProgress);

    private bool IsFaseInProgress(Fase fase) => DashboardService.IsFaseInProgress(fase, userProgress);

    private void NavigateToFase(int faseId)
    {
        NavigationManager.NavigateTo($"/fase/{faseId}");
    }

    private async Task OnCardKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, int faseId)
    {
        if (e.Key is "Enter" or " ")
        {
            NavigateToFase(faseId);
            await Task.CompletedTask;
        }
    }
}
