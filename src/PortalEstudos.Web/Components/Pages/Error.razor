@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Ocorreu um erro.</h1>
<h2 class="text-danger">Algo deu errado ao processar sua requisição.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de Desenvolvimento</h3>
<p>
    Trocar para o ambiente <strong>Development</strong> exibe informações mais detalhadas
    sobre o erro ocorrido.
</p>
<p>
    <strong>O ambiente Development não deve estar habilitado em aplicações implantadas.</strong>
    Isso pode expor informações sensíveis das exceções aos usuários finais.
</p>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        // Não dependemos mais de [CascadingParameter] HttpContext: ele é null em pré-renderização
        // e mesmo quando presente, não precisamos dele para identificar a requisição.
        RequestId = Activity.Current?.Id;
    }
}