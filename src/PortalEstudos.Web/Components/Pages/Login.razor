@page "/login"
@page "/registro"
@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>@(ModoRegistro ? "Criar Conta" : "Entrar") - Portal de Estudos C#</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center min-vh-75 py-12">
    <MudPaper Elevation="4" Class="pa-8 rounded-xl w-100" Style="max-width: 440px; border: 1px solid rgba(102, 126, 234, 0.15);">
        
        @* --- CABECALHO --- *@
        <div class="text-center mb-6">
            <div class="d-inline-flex pa-3 rounded-circle mb-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; box-shadow: 0 4px 14px rgba(102, 126, 234, 0.35);">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">
                @(ModoRegistro ? "Criar Conta" : "Entrar no Portal")
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                @(ModoRegistro ? "Cadastre-se para acompanhar seus estudos e submissões" : "Informe seus dados de acesso para continuar")
            </MudText>
        </div>

        @* --- ALERTA DE ERRO --- *@
        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-5 rounded-lg" Dense="true">
                @MensagemErroAmigavel
            </MudAlert>
        }

        @* --- FORMULARIO DE LOGIN --- *@
        @if (!ModoRegistro)
        {
            <form method="post" action="/api/auth/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-4">
                    <label for="login-email" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary" />
                        Email
                    </label>
                    <input id="login-email" type="email" name="email" required placeholder="seu.email@exemplo.com"
                           class="auth-input" />
                </div>

                <div class="mb-6">
                    <label for="login-password" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Primary" />
                        Senha
                    </label>
                    <input id="login-password" type="password" name="password" required placeholder="••••••••"
                           class="auth-input" />
                </div>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login"
                           Class="rounded-lg py-3 font-weight-bold" Style="box-shadow: 0 4px 12px rgba(102, 126, 234, 0.35);">
                    Entrar
                </MudButton>
            </form>

            <MudDivider Class="my-6" />

            <div class="text-center">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Não tem uma conta?
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="pa-0 ml-1 font-weight-bold"
                               OnClick="@(() => AlternarModo(true))">
                        Cadastre-se
                    </MudButton>
                </MudText>
            </div>
        }
        else
        {
            @* --- FORMULARIO DE REGISTRO --- *@
            <form method="post" action="/api/auth/register">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-4">
                    <label for="reg-nome" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Primary" />
                        Nome Completo
                    </label>
                    <input id="reg-nome" type="text" name="nome" required placeholder="Como prefere ser chamado?"
                           class="auth-input" />
                </div>

                <div class="mb-4">
                    <label for="reg-email" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary" />
                        Email
                    </label>
                    <input id="reg-email" type="email" name="email" required placeholder="seu.email@exemplo.com"
                           class="auth-input" />
                </div>

                <div class="mb-4">
                    <label for="reg-password" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Primary" />
                        Senha
                    </label>
                    <input id="reg-password" type="password" name="password" minlength="6" required placeholder="Mínimo 6 caracteres"
                           class="auth-input" />
                </div>

                <div class="mb-6">
                    <label for="reg-confirm-password" class="d-flex align-center gap-1 mb-1 font-weight-bold mud-typography-caption">
                        <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" Color="Color.Primary" />
                        Confirme a Senha
                    </label>
                    <input id="reg-confirm-password" type="password" name="confirmPassword" minlength="6" required placeholder="Repita a senha digitada"
                           class="auth-input" />
                </div>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd"
                           Class="rounded-lg py-3 font-weight-bold" Style="box-shadow: 0 4px 12px rgba(102, 126, 234, 0.35);">
                    Criar Conta
                </MudButton>
            </form>

            <MudDivider Class="my-6" />

            <div class="text-center">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Já possui uma conta?
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="pa-0 ml-1 font-weight-bold"
                               OnClick="@(() => AlternarModo(false))">
                        Fazer Login
                    </MudButton>
                </MudText>
            </div>
        }
    </MudPaper>
</MudContainer>

<style>
    .auth-input {
        width: 100%;
        padding: 11px 13px;
        border-radius: 8px;
        border: 1px solid rgba(128, 128, 128, 0.3);
        background-color: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        font-size: 0.95rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        box-sizing: border-box;
    }

    .auth-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.25);
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Mode { get; set; }

    private bool ModoRegistro { get; set; }

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri;
        if (uri.Contains("/registro", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Mode, "register", StringComparison.OrdinalIgnoreCase))
        {
            ModoRegistro = true;
        }
    }

    private void AlternarModo(bool registro)
    {
        ModoRegistro = registro;
        Error = null;
    }

    private string MensagemErroAmigavel => Error switch
    {
        "credenciais_invalidas" => "Credenciais incorretas. Verifique seu e-mail e senha.",
        "senhas_diferentes" => "A confirmação da senha não confere com a senha digitada.",
        null or "" => string.Empty,
        _ => Uri.UnescapeDataString(Error)
    };
}
