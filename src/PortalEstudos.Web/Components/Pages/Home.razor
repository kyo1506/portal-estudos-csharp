@page "/"
@using MudBlazor
@inject NavigationManager NavigationManager
@inject IProgressService ProgressService
@inject IDashboardService DashboardService

<PageTitle>Portal de Estudos - C# e .NET</PageTitle>

@if (stats == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate Class="my-8" />
}
else
{
    <!-- Hero -->
    <section class="home-hero">
        <div class="home-hero-left">
            <div class="home-hero-overline">Portal de Estudos · C# e .NET 10</div>
            <h1 class="home-hero-title">🚀 Aprenda C# de verdade</h1>
            <p class="home-hero-subtitle">
                Uma jornada guiada por 4 semanas — teoria, exemplos práticos, exercícios e
                desafios — no seu ritmo, com progresso acompanhado.
            </p>
            <div class="home-hero-ctas">
                <MudButton Color="Color.Surface" Variant="Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Filled.School" OnClick="NavigateToWeeks">
                    Começar a Estudar
                </MudButton>
                <MudButton Color="Color.Default" Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Filled.Insights" OnClick="NavigateToDashboard" Class="home-hero-ghost">
                    Ver Progresso
                </MudButton>
            </div>
        </div>

        <div class="home-hero-right">
            <MudPaper Class="home-hero-card" Elevation="4">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Sua jornada</MudText>
                <div class="home-hero-rings">
                    <div class="home-hero-ring">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Value="@stats.ProgressPercentage" Class="home-hero-ring-circular">
                            <MudText Typo="Typo.h6" Class="font-weight-bold">@stats.ProgressPercentage%</MudText>
                        </MudProgressCircular>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">geral</MudText>
                    </div>
                    <div class="home-hero-stat">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@stats.TotalWeeks</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">semanas</MudText>
                    </div>
                    <div class="home-hero-stat">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@stats.TotalLessons</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">lições</MudText>
                    </div>
                    <div class="home-hero-stat">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">@stats.TotalExercises</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">exercícios</MudText>
                    </div>
                </div>
                <MudProgressLinear Color="Color.Primary" Value="@stats.ProgressPercentage" Rounded Class="mt-2" />
            </MudPaper>
        </div>
    </section>

    <!-- Como você vai aprender -->
    <MudText Typo="Typo.h5" Class="mt-6 mb-4 font-weight-bold text-center">Como você vai aprender</MudText>
    <MudGrid Spacing="4" Class="mb-6 stretch-grid">
        <MudItem xs="12" sm="6" lg="3" Class="d-flex">
            <MudPaper Class="home-journey-card flex-fill" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">1. Teoria</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Fundamentos de C# e .NET explicados com clareza e exemplos reais.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3" Class="d-flex">
            <MudPaper Class="home-journey-card flex-fill" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">2. Exemplos</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Código real e executável para entender na prática como cada conceito funciona.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3" Class="d-flex">
            <MudPaper Class="home-journey-card flex-fill" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">3. Exercícios</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Pratique no editor integrado e confira o resultado esperado.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3" Class="d-flex">
            <MudPaper Class="home-journey-card flex-fill" Elevation="2">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Error" Size="Size.Large" Class="mb-2" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">4. Desafios</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Projetos semanais enviados via Pull Request no GitHub para code review.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- CTA -->
    <MudPaper Class="home-cta pa-6" Elevation="3">
        <div>
            <MudText Typo="Typo.h6" Class="font-weight-bold">Pronta para começar?</MudText>
            <MudText Typo="Typo.body2" Class="home-cta-sub">Explore as semanas do curso e avance no seu ritmo.</MudText>
        </div>
        <MudButton Color="Color.Surface" Variant="Variant.Filled" Size="Size.Large" OnClick="NavigateToWeeks" StartIcon="@Icons.Material.Filled.ArrowForward">
            Ver Semanas
        </MudButton>
    </MudPaper>
}

@code {
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var progress = await ProgressService.LoadAsync();
        stats = DashboardService.GetStats(progress);
    }

    private void NavigateToWeeks() => NavigationManager.NavigateTo("/weeks");
    private void NavigateToDashboard() => NavigationManager.NavigateTo("/dashboard");
}
