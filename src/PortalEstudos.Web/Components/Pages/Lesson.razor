@page "/fase/{faseId}/lesson/{lessonId}"
@using MudBlazor
@inject ICatalogService CatalogService
@inject IProgressService ProgressService
@inject IMarkdownRenderer MarkdownRenderer
@inject IDuvidaService DuvidaService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>@lesson?.Title - Portal de Estudos C#</PageTitle>
<HeadContent>
    <meta name="description" content="Aula de C# e .NET: @lesson?.Title, teoria e exemplos práticos." />
</HeadContent>

@if (isLoading)
{
    <MudGrid Spacing="4">
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4" Elevation="2">
                <MudSkeleton SkeletonType="SkeletonType.Text" />
                <MudSkeleton SkeletonType="SkeletonType.Text" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
        </MudItem>
    </MudGrid>
}
else if (fase == null || lesson == null)
{
    <MudPaper Class="pa-8 text-center" Elevation="3">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-3" />
        <MudText Typo="Typo.h5" Class="mb-2">Lição não encontrada</MudText>
        <MudText Class="mud-text-secondary mb-4">A lição que você procura não existe.</MudText>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/fases">Voltar para Fases</MudButton>
    </MudPaper>
}
else
{
    <MudButton Color="Color.Default" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@($"/fase/{fase?.Id}")" Class="mb-2">
        Voltar para Fase @fase?.Id
    </MudButton>

    <div class="breadcrumb-row mb-3">
        <MudLink Href="/fases">Fases</MudLink>
        <span class="breadcrumb-sep">/</span>
        <MudLink Href="@($"/fase/{fase!.Id}")">Fase @fase.Id</MudLink>
        <span class="breadcrumb-sep">/</span>
        <span class="mud-text-secondary">Lição @lesson!.Order</span>
    </div>

    <MudGrid Spacing="4">
        <!-- Conteúdo da lição -->
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4" Elevation="2">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                    <MudText Typo="Typo.h4" Class="font-weight-bold">📖 @lesson.Title</MudText>
                    @if (userProgress.CompletedLessons.Contains(lesson.Id))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-1" /> Concluída
                        </MudChip>
                    }
                </div>
                <MudDivider Class="mb-3" />
                <div class="markdown-content">
                    @((MarkupString)ConvertMarkdownToHtml(lesson.Content))
                </div>
            </MudPaper>

            @if (!string.IsNullOrEmpty(lesson.CodeExample))
            {
                <MudExpansionPanel Class="mt-4">
                    <TitleContent>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Default" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Exemplo de Código (@(lesson!.CodeLanguage ?? "csharp"))</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <pre class="code-block">@lesson.CodeExample</pre>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudItem>

        <!-- Sidebar -->
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-3 mb-4" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" />Lições da Fase
                </MudText>
                <div class="lesson-list">
                    @foreach (var l in fase!.Lessons.OrderBy(l => l.Order))
                    {
                        var done = userProgress.CompletedLessons.Contains(l.Id);
                        <a href="@($"/fase/{fase.Id}/lesson/{l.Id}")"
                           class="lesson-list-item @(l.Id == lesson!.Id ? "active" : "")"
                          
                           style="display:flex; align-items:center; gap:0.5rem; padding:0.5rem 0.75rem; border-radius:0.5rem; text-decoration:none; color:inherit; @(l.Id == lesson.Id ? "background:rgba(102,126,234,0.12);" : "")">
                            <MudIcon Icon="@(l.Id == lesson.Id ? Icons.Material.Filled.MenuBook : Icons.Material.Filled.BookmarkBorder)"
                                     Color="@(l.Id == lesson.Id ? Color.Primary : Color.Default)" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="@(l.Id == lesson.Id ? "font-weight-bold" : "")">@l.Title</MudText>
                            @if (done)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="ml-auto" Size="Size.Small" />
                            }
                        </a>
                    }
                </div>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="2">
                @if (userProgress.CompletedLessons.Contains(lesson.Id))
                {
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" FullWidth Class="mb-2" StartIcon="@Icons.Material.Filled.Refresh" OnClick="MarkAsIncomplete">
                        Marcar como não concluída
                    </MudButton>
                }
                else
                {
                    <MudButton Color="Color.Success" Variant="Variant.Filled" FullWidth Class="mb-2" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="MarkAsComplete">
                        Marcar como concluída
                    </MudButton>
                }
                <MudGrid Spacing="2">
                    <MudItem xs="6">
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" FullWidth Disabled="@(GetPreviousLessonHref() == null)" StartIcon="@Icons.Material.Filled.ChevronLeft" Href="@GetPreviousLessonHref()" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" FullWidth Disabled="@(GetNextLessonHref() == null)" EndIcon="@Icons.Material.Filled.ChevronRight" Href="@GetNextLessonHref()" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Ficou com dúvida neste conteúdo teórico?</MudText>
                    </div>
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleDuvidaForm" StartIcon="@Icons.Material.Filled.QuestionAnswer">
                        @(showDuvidaForm ? "Ocultar" : "Tirar Dúvida")
                    </MudButton>
                </div>

                @if (showDuvidaForm)
                {
                    <div class="mt-4">
                        <AuthorizeView>
                            <Authorized>
                                @if (duvidaEnviadaComSucesso)
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                                        Dúvida enviada com sucesso! Você pode acompanhar as respostas em "Minhas Dúvidas".
                                    </MudAlert>
                                }
                                <MudTextField @bind-Value="duvidaTitulo" Label="Título da Dúvida" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                                <MudTextField @bind-Value="duvidaDescricao" Label="Qual conceito ou exemplo não ficou claro?" Lines="3" Variant="Variant.Outlined" Dense="true" Class="mb-3" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           Disabled="@isEnviandoDuvida"
                                           OnClick="EnviarDuvida" StartIcon="@Icons.Material.Filled.Send">
                                    Enviar Pergunta ao Mentor
                                </MudButton>
                            </Authorized>
                            <NotAuthorized>
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                    Para enviar dúvidas à mentoria, faça login na sua conta.
                                </MudAlert>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" Href="/login">
                                    Fazer Login
                                </MudButton>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<style>
    .markdown-content { line-height: 1.8; }
    .markdown-content h2 { color: #764ba2; margin-top: 1.5rem; margin-bottom: 1rem; font-weight: 600; }
    .markdown-content h3 { margin-top: 1.25rem; margin-bottom: 0.75rem; font-weight: 600; }
    .markdown-content p { margin-bottom: 1rem; }
    .markdown-content ul, .markdown-content ol { margin-bottom: 1rem; padding-left: 1.5rem; }
    .breadcrumb-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
    .breadcrumb-sep { color: var(--mud-palette-text-secondary, #6c757d); }
</style>

@code {
    private bool isLoading = true;
    private Fase? fase;
    private LessonModel? lesson;
    private UserProgress userProgress = new();
    private string? _loadedKey;
    private int _loadToken;

    private bool showDuvidaForm = false;
    private bool isEnviandoDuvida = false;
    private bool duvidaEnviadaComSucesso = false;
    private string duvidaTitulo = "";
    private string duvidaDescricao = "";

    [Parameter]
    public string? FaseId { get; set; }

    [Parameter]
    public string? LessonId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{FaseId}/{LessonId}";
        var token = ++_loadToken;

        // A navegação entre lições reutiliza a instância e só troca os parâmetros;
        // por isso o carregamento vive aqui (OnParametersSetAsync) e não em OnInitializedAsync.
        if (_loadedKey == key)
            return;

        _loadedKey = key;
        isLoading = true;
        StateHasChanged();

        fase = null;
        lesson = null;
        if (int.TryParse(FaseId, out int faseId) && int.TryParse(LessonId, out int lessonId))
        {
            fase = CatalogService.GetFase(faseId);
            lesson = CatalogService.GetLesson(faseId, lessonId);
        }
        userProgress = await ProgressService.LoadAsync();

        if (token == _loadToken)
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userProgress = await ProgressService.LoadAsync(forceReload: true);
            StateHasChanged();
        }
    }

    private string ConvertMarkdownToHtml(string markdown) => MarkdownRenderer.ToHtml(markdown);

    private string? GetPreviousLessonHref()
    {
        if (fase == null || lesson == null) return null;
        var orderedLessons = fase.Lessons.OrderBy(l => l.Order).ToList();
        var currentIndex = orderedLessons.FindIndex(l => l.Id == lesson.Id);
        return currentIndex > 0 ? $"/fase/{FaseId}/lesson/{orderedLessons[currentIndex - 1].Id}" : null;
    }

    private string? GetNextLessonHref()
    {
        if (fase == null || lesson == null) return null;
        var orderedLessons = fase.Lessons.OrderBy(l => l.Order).ToList();
        var currentIndex = orderedLessons.FindIndex(l => l.Id == lesson.Id);
        return currentIndex < orderedLessons.Count - 1 ? $"/fase/{FaseId}/lesson/{orderedLessons[currentIndex + 1].Id}" : null;
    }

    private async Task MarkAsComplete()
    {
        if (lesson != null)
        {
            await ProgressService.MarkLessonCompleteAsync(lesson.Id, fase?.Id);
            userProgress = await ProgressService.LoadAsync();
            StateHasChanged();
        }
    }

    private async Task MarkAsIncomplete()
    {
        if (lesson != null)
        {
            await ProgressService.MarkLessonIncompleteAsync(lesson.Id, fase?.Id);
            userProgress = await ProgressService.LoadAsync();
            StateHasChanged();
        }
    }

    private void ToggleDuvidaForm()
    {
        showDuvidaForm = !showDuvidaForm;
        duvidaEnviadaComSucesso = false;
        if (showDuvidaForm && string.IsNullOrEmpty(duvidaTitulo) && lesson != null)
        {
            duvidaTitulo = $"Dúvida em: {lesson.Title}";
        }
    }

    private async Task EnviarDuvida()
    {
        if (string.IsNullOrWhiteSpace(duvidaTitulo) || string.IsNullOrWhiteSpace(duvidaDescricao))
        {
            Snackbar.Add("Preencha o título e a descrição da dúvida.", Severity.Warning);
            return;
        }

        var userId = await CurrentUserAccessor.GetCurrentUserIdAsync();
        if (!userId.HasValue) return;

        isEnviandoDuvida = true;
        try
        {
            var input = new CriarDuvidaInput(
                FaseId: fase?.Id ?? 0,
                LicaoId: lesson?.Id,
                ExercicioId: null,
                Titulo: duvidaTitulo,
                Descricao: duvidaDescricao,
                TrechoCodigo: null
            );

            await DuvidaService.EnviarDuvidaAsync(userId.Value, input);
            duvidaEnviadaComSucesso = true;
            duvidaDescricao = "";
            Snackbar.Add("Dúvida enviada com sucesso!", Severity.Success);
        }
        finally
        {
            isEnviandoDuvida = false;
        }
    }

    private void NavigateToFase()
    {
        NavigationManager.NavigateTo($"/fase/{FaseId}");
    }
}
